# .env olarak kopyalayın (.env asla commit edilmez).

# Zorunlu. Boş bırakılırsa kurulum.ps1 rastgele üretir. Şifreleme anahtarı
# sonradan değişirse n8n'deki kayıtlı kimlik bilgileri okunamaz.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Fatura webhook'una gönderen sistemlerin X-API-Key başlığında yolladığı anahtar.
FATURA_API_KEY=
# Asistan sohbet sayfasının girişi.
# ASISTAN_KULLANICI=muhasebe
ASISTAN_SIFRE=

# İsteğe bağlı.
# POSTGRES_USER=otomasyon
# POSTGRES_DB=otomasyon
# N8N_VERSION=2.48.7
# N8N_PORT=5678
# TIMEZONE=Europe/Istanbul

# Onay linklerinin adresi. Telefondan Telegram ile onay için dışarıdan erişilen
# adres olmalı (ör. Cloudflare Tunnel veya ngrok adresi), sonunda / olmadan.
# PUBLIC_URL=http://localhost:5678

# Entegrasyonlar (README, "Telegram, Gmail ve Google Sheets"). Doldurup
# kurulum.ps1'i tekrar çalıştırınca ilgili node'lar açılır.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# GOOGLE_SHEET_URL=

# Asistan modelinin CPU thread sayısı (README, "Hız"). Değiştirince
# kurulum.ps1'i tekrar çalıştırın.
# OLLAMA_NUM_THREAD=8

# Extractor: yüksek doğruluk modu (OpenAI) için. Yoksa yerel mod çalışır.
# OPENAI_API_KEY=
# OLLAMA_HOST=http://ollama:11434

# RAG: PDF tablolarını hücreleriyle oku (Docling TableFormer, ~360 MB indirir).
# Değiştirince belgeleri yeniden yükleyin.
# RAG_TABLE_STRUCTURE=false
